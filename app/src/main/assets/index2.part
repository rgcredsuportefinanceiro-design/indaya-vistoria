('clientes',this)"><span>👥</span>Locatários</button><button onclick="go('mais',this)"><span>☰</span>Mais</button></nav>
<div id="modal" class="modal hidden"><div class="sheet"><div class="sheetHead"><b id="modalTitle"></b><button class="close" onclick="closeModal()">×</button></div><div id="modalBody"></div></div></div>
<script>
const KEY='indaya_v2';let db=JSON.parse(localStorage.getItem(KEY)||'null')||{settings:{pin:'1234',company:'Indayá Locações'},vehicles:[],clients:[],inspections:[],rentals:[],maintenance:[]};
const checks=['Pneus','Óleo do motor','Água / Aditivo','Luzes e faróis','Limpadores','Vidros e retrovisores','Lataria','Interior e limpeza','Documentos','Estepe / Macaco / Chave de roda'];let sigCtx=null,sigDown=false;
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}function esc(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}function nowLocal(){let d=new Date();d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16)}function dbr(s){if(!s)return'';let d=new Date(s);return isNaN(d)?s:d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}function badge(s){let c=s==='Aprovado'?'ok':s==='Precisa de atenção'?'att':s==='Não liberar'?'bad':s==='Ativa'?'info':s==='Disponível'?'ok':s==='Em uso'?'info':'att';return `<span class="tag ${c}">${esc(s)}</span>`}
function openModal(t,h){modalTitle.textContent=t;modalBody.innerHTML=h;modal.classList.remove('hidden')}function closeModal(){modal.classList.add('hidden')}function go(p,b){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById(p).classList.add('active');document.querySelectorAll('.bottom button').forEach(x=>x.classList.remove('active'));if(b)b.classList.add('active');render()}
function doLogin(){if(pin.value===(db.settings.pin||'1234')){sessionStorage.setItem('indaya_auth','1');login.classList.add('hidden');pin.value=''}else alert('PIN incorreto.')}function ensureLogin(){if(sessionStorage.getItem('indaya_auth')!=='1')login.classList.remove('hidden')}
function weekStart(d=new Date()){let x=new Date(d),day=(x.getDay()+6)%7;x.setHours(0,0,0,0);x.setDate(x.getDate()-day);return x}function lastInspection(vid){return db.inspections.filter(x=>x.vehicleId===vid).sort((a,b)=>new Date(b.date)-new Date(a.date))[0]}function isDue(v){let li=lastInspection(v.id);if(!li)return true;return new Date(li.date)<weekStart()}
function render(){mUse.textContent=db.vehicles.filter(v=>v.status==='Em uso').length;mMaint.textContent=db.maintenance.filter(m=>!m.done).length;let ws=weekStart();mWeek.textContent=db.inspections.filter(x=>new Date(x.date)>=ws).length;mPending.textContent=db.vehicles.filter(isDue).length;renderVehicles();renderClients();let due=db.vehicles.filter(isDue);dueList.innerHTML=due.length?due.map(v=>`<div class="row due" onclick="openWeekly('${v.id}')"><div class="grow"><b>${esc(v.plate)} • ${esc(v.brand)} ${esc(v.model)}</b><small>${lastInspection(v.id)?'Última: '+dbr(lastInspection(v.id).date):'Sem vistoria registrada'}</small></div><span class="tag bad">Pendente</span></div>`).join(''):'<div class="empty">Todas as vistorias da semana estão em dia.</div>';let hist=[...db.inspections.map(x=>({...x,kind:'Vistoria semanal'})),...db.rentals.flatMap(r=>[{...r.checkout,vehicleId:r.vehicleId,date:r.checkout?.date,kind:'Retirada',status:r.status},...(r.return?[{...r.return,vehicleId:r.vehicleId,date:r.return.date,kind:'Devolução',status:'Encerrada'}]:[])])].filter(x=>x.date).sort((a,b)=>new Date(b.date)-new Date(a.date)).slice(0,6);latest.innerHTML=hist.length?hist.map(x=>{let v=db.vehicles.find(z=>z.id===x.vehicleId);return `<div class="row"><div class="grow"><b>${esc(v?.plate||'Veículo')} • ${esc(x.kind)}</b><small>${dbr(x.date)}${x.km?' • '+esc(x.km)+' km':''}</small></div>${x.kind==='Vistoria semanal'?badge(x.status):''}</div>`}).join(''):'<div class="empty">Nenhum registro.</div>'}
function renderVehicles(){if(!vehicleList)return;let q=(vehicleSearch?.value||'').toLowerCase();let list=db.vehicles.filter(v=>(v.plate+' '+v.brand+' '+v.model).toLowerCase().includes(q));vehicleList.innerHTML=list.length?list.map(v=>`<div class="row" onclick="vehicleDetail('${v.id}')"><div class="grow"><b>${esc(v.plate)} • ${esc(v.brand)} ${esc(v.model)}</b><small>${esc(v.year||'')} ${esc(v.color||'')} • ${esc(v.km||'0')} km<br>Vistoria semanal: ${isDue(v)?'<span style="color:#b62424;font-weight:800">pendente</span>':'em dia'}</small></div>${badge(v.status||'Disponível')}</div>`).join(''):'<div class="empty">Nenhum veículo.</div>'}
function renderClients(){if(!clientList)return;let q=(clientSearch?.value||'').toLowerCase();let list=db.clients.filter(c=>(c.name+' '+c.cpf+' '+c.phone).toLowerCase().includes(q));clientList.innerHTML=list.length?list.map(c=>`<div class="row" onclick="clientDetail('${c.id}')"><div class="grow"><b>${esc(c.name)}</b><small>${esc(c.phone||'Sem telefone')} • CPF ${esc(c.cpf||'não informado')}</small></div>›</div>`).join(''):'<div class="empty">Nenhum locatário.</div>'}
function openVehicle(eid=''){let v=db.vehicles.find(x=>x.id===eid)||{};openModal(eid?'Editar veículo':'Novo veículo',`<div class="two"><div class="field"><label>Placa *</label><input id="vPlate" value="${esc(v.plate||'')}" style="text-transform:uppercase"></div><div class="field"><label>Status</label><select id="vStatus"><option ${v.status==='Disponível'?'selected':''}>Disponível</option><option ${v.status==='Em uso'?'selected':''}>Em uso</option><option ${v.status==='Manutenção'?'selected':''}>Manutenção</option></select></div></div><div class="two"><div class="field"><label>Marca *</label><input id="vBrand" value="${esc(v.brand||'')}"></div><div class="field"><label>Modelo *</label><input id="vModel" value="${esc(v.model||'')}"></div></div><div class="three"><div class="field"><label>Ano</label><input id="vYear" value="${esc(v.year||'')}"></div><div class="field"><label>Cor</label><input id="vColor" value="${esc(v.color||'')}"></div><div class="field"><label>KM</label><input id="vKm" type="number" value="${esc(v.km||'')}"></div></div><div class="field"><label>Observações</label><textarea id="vObs">${esc(v.obs||'')}</textarea></div><button class="btn full primary" onclick="saveVehicle('${eid}')">Salvar</button>`)}
function saveVehicle(eid){let p=vPlate.value.trim().toUpperCase(),b=vBrand.value.trim(),m=vModel.value.trim();if(!p||!b||!m)return alert('Preencha placa, marca e modelo.');if(db.vehicles.some(x=>x.plate===p&&x.id!==eid))return alert('Esta placa já está cadastrada.');let obj={id:eid||uid(),plate:p,brand:b,model:m,year:vYear.value,color:vColor.value,km:vKm.value,status:vStatus.value,obs:vObs.value};if(eid)Object.assign(db.vehicles.find(x=>x.id===eid),obj);else db.vehicles.push(obj);save();closeModal()}
function vehicleDetail(id){let v=db.vehicles.find(x=>x.id===id),li=lastInspection(id),maint=db.maintenance.filter(m=>m.vehicleId===id&&!m.done);openModal(v.plate,`<div class="card"><b>${esc(v.brand)} ${esc(v.model)}</b><div class="sub">${esc(v.year||'')} • ${esc(v.color||'')} • ${esc(v.km||'0')} km</div><div style="margin-top:8px">${badge(v.status)}</div></div><div class="section">Vistoria semanal</div><div class="row"><div class="grow"><b>${isDue(v)?'Pendente':'Em dia'}</b><small>${li?'Última em '+dbr(li.date):'Nunca realizada'}</small></div><button class="btn primary" onclick="openWeekly('${id}')">Vistoriar</button></div><div class="section">Manutenção pendente</div>${maint.length?maint.map(m=>`<div class="row"><div class="grow"><b>${esc(m.title||'Pendência')}</b><small>${esc(m.reason||'')}</small></div></div>`).join(''):'<div class="empty">Nenhuma pendência.</div>'}<div class="actions"><button class="btn secondary" onclick="openVehicle('${id}')">Editar</button><button class="btn danger" onclick="deleteVehicle('${id}')">Excluir</button></div>`)}
function deleteVehicle(id){if(db.rentals.some(r=>r.vehicleId===id&&r.status==='Ativa'))return alert('Não é possível excluir veículo com locação ativa.');if(confirm('Excluir este veículo?')){db.vehicles=db.vehicles.filter(x=>x.id!==id);save();closeModal()}}
function openClient(eid=''){let c=db.clients.find(x=>x.id===eid)||{};openModal(eid?'Editar locatário':'Novo locatário',`<div class="field"><label>Nome *</label><input id="cName" value="${esc(c.name||'')}"></div><div class="two"><div class="field"><label>CPF</label><input id="cCpf" value="${esc(c.cpf||'')}"></div><div class="field"><label>Telefone</label><input id="cPhone" value="${esc(c.phone||'')}"></div></div><div class="field"><label>CNH</label><input id="cCnh" value="${esc(c.cnh||'')}"></div><div class="field"><label>Observações</label><textarea id="cObs">${esc(c.obs||'')}</textarea></div><button class="btn full primary" onclick="saveClient('${eid}')">Salvar</button>`)}function saveClient(eid){if(!cName.value.trim())return alert('Informe o nome.');let o={id:eid||uid(),name:cName.value.trim(),cpf:cCpf.value,phone:cPhone.value,cnh:cCnh.value,obs:cObs.value};if(eid)Object.assign(db.clients.find(x=>x.id===eid),o);else db.clients.push(o);save();closeModal()}function clientDetail(id){let c=db.clients.find(x=>x.id===id);openModal(c.name,`<div class="card"><b>${esc(c.name)}</b><div class="sub">CPF ${esc(c.cpf||'-')}<br>Telefone ${esc(c.phone||'-')}<br>CNH ${esc(c.cnh||'-')}</div></div><div class="actions"><button class="btn secondary" onclick="openClient('${id}')">Editar</button><button class="btn danger" onclick="deleteClient('${id}')">Excluir</button></div>`)}function deleteClient(id){if(db.rentals.some(r=>r.clientId===id&&r.status==='Ativa'))return alert('Locatário possui locação ativa.');if(confirm('Excluir locatário?')){db.clients=db.clients.filter(x=>x.id!==id);save();closeModal()}}
function vopts(filterAvail=false,sel=''){let l=filterAvail?db.vehicles.filter(v=>v.status==='Disponível'):db.vehicles;return l.map(v=>`<option value="${v.id}" ${v.id===sel?'selected':''}>${esc(v.plate)} • ${esc(v.brand)} ${esc(v.model)}</option>`).join('')}function copts(sel=''){return db.clients.map(c=>`<option value="${c.id}" ${c.id===sel?'selected':''}>${esc(c.name)}</option>`).join('')}
function photoInputs(prefix,names){return `<div class="photos">${names.map((n,i)=>`<label class="photoBox"><span>📷<br>${n}</span><input id="${prefi