x}${i}" type="file" accept="image/*" capture="environment" onchange="previewPhoto(this)"></label>`).join('')}</div>`}function previewPhoto(inp){let f=inp.files?.[0];if(!f)return;let img=document.createElement('img');img.src=URL.createObjectURL(f);inp.parentElement.querySelector('img')?.remove();inp.parentElement.appendChild(img)}function compressFile(file){return new Promise(res=>{if(!file)return res(null);let im=new Image(),u=URL.createObjectURL(file);im.onload=()=>{let mx=1100,s=Math.min(1,mx/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*s);c.height=Math.round(im.height*s);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);res(c.toDataURL('image/jpeg',.66))};im.src=u})}async function collectPhotos(prefix,count){let a=[];for(let i=0;i<count;i++){let f=document.getElementById(prefix+i)?.files?.[0];if(f)a.push(await compressFile(f))}return a}
function openCheckout(){if(!db.vehicles.some(v=>v.status==='Disponível'))return alert('Não há veículo disponível.');if(!db.clients.length)return alert('Cadastre um locatário primeiro.');openModal('Registrar retirada',`<div class="field"><label>Veículo *</label><select id="rVehicle">${vopts(true)}</select></div><div class="field"><label>Locatário *</label><select id="rClient">${copts()}</select></div><div class="two"><div class="field"><label>Data/hora</label><input id="rDate" type="datetime-local" value="${nowLocal()}"></div><div class="field"><label>KM</label><input id="rKm" type="number"></div></div><div class="field"><label>Combustível</label><select id="rFuel"><option>Reserva</option><option>1/4</option><option>1/2</option><option>3/4</option><option selected>Cheio</option></select></div><div class="section">Fotos de saída</div>${photoInputs('rp',['Frente','Traseira','Lateral esquerda','Lateral direita','Painel / KM','Interior'])}<div class="field"><label>Observações / avarias existentes</label><textarea id="rObs"></textarea></div><button class="btn full primary" onclick="saveCheckout()">Finalizar retirada</button>`)}async function saveCheckout(){let photos=await collectPhotos('rp',6),rid=uid(),vid=rVehicle.value;db.rentals.push({id:rid,vehicleId:vid,clientId:rClient.value,status:'Ativa',checkout:{date:rDate.value,km:rKm.value,fuel:rFuel.value,obs:rObs.value,photos},return:null});let v=db.vehicles.find(x=>x.id===vid);v.status='Em uso';if(rKm.value)v.km=rKm.value;save();closeModal();alert('Retirada registrada.')}function activeRentals(){return db.rentals.filter(r=>r.status==='Ativa')}
function openReturn(){let a=activeRentals();if(!a.length)return alert('Não há locação ativa para devolver.');openModal('Registrar devolução',`<div class="field"><label>Locação ativa</label><select id="dRental" onchange="returnSummary()">${a.map(r=>{let v=db.vehicles.find(x=>x.id===r.vehicleId),c=db.clients.find(x=>x.id===r.clientId);return `<option value="${r.id}">${esc(v?.plate)} • ${esc(c?.name)}</option>`}).join('')}</select></div><div id="retSummary" class="note"></div><div class="two"><div class="field"><label>Data/hora</label><input id="dDate" type="datetime-local" value="${nowLocal()}"></div><div class="field"><label>KM</label><input id="dKm" type="number"></div></div><div class="field"><label>Combustível</label><select id="dFuel"><option>Reserva</option><option>1/4</option><option>1/2</option><option>3/4</option><option>Cheio</option></select></div><div class="section">Fotos da devolução</div>${photoInputs('dp',['Frente','Traseira','Lateral esquerda','Lateral direita','Painel / KM','Interior'])}<div class="field"><label>Novas avarias / observações</label><textarea id="dObs"></textarea></div><div class="field"><label><input id="dMaint" type="checkbox"> Gerar pendência de manutenção</label></div><button class="btn full primary" onclick="saveReturn()">Finalizar devolução</button>`);setTimeout(returnSummary,20)}function returnSummary(){let r=db.rentals.find(x=>x.id===dRental.value);if(!r)return;retSummary.innerHTML=`Retirada: <b>${dbr(r.checkout.date)}</b><br>KM saída: <b>${esc(r.checkout.km||'-')}</b> • Combustível: <b>${esc(r.checkout.fuel||'-')}</b><br>${esc(r.checkout.obs||'Sem observações de saída')}`}
async function saveReturn(){let r=db.rentals.find(x=>x.id===dRental.value),photos=await collectPhotos('dp',6);r.return={date:dDate.value,km:dKm.value,fuel:dFuel.value,obs:dObs.value,photos};r.status='Encerrada';let v=db.vehicles.find(x=>x.id===r.vehicleId);v.status=dMaint.checked?'Manutenção':'Disponível';if(dKm.value)v.km=dKm.value;if(dMaint.checked)db.maintenance.push({id:uid(),vehicleId:v.id,date:dDate.value,title:'Avaria na devolução',reason:dObs.value||'Verificar veículo após devolução',done:false});save();closeModal();alert('Devolução registrada.')}function showRentals(){let list=[...db.rentals].sort((a,b)=>new Date(b.checkout.date)-new Date(a.checkout.date));openModal('Locações',`<div class="tabs"><button class="tab active" onclick="filterRental(this,'all')">Todas</button><button class="tab" onclick="filterRental(this,'Ativa')">Ativas</button><button class="tab" onclick="filterRental(this,'Encerrada')">Encerradas</button></div><div id="rentalList" class="list" style="margin-top:10px">${rentalRows(list)}</div>`)}function rentalRows(list){return list.length?list.map(r=>{let v=db.vehicles.find(x=>x.id===r.vehicleId),c=db.clients.find(x=>x.id===r.clientId);return `<div class="row" data-status="${r.status}" onclick="rentalDetail('${r.id}')"><div class="grow"><b>${esc(v?.plate)} • ${esc(c?.name)}</b><small>Retirada ${dbr(r.checkout.date)}${r.return?'<br>Devolução '+dbr(r.return.date):''}</small></div>${badge(r.status)}</div>`}).join(''):'<div class="empty">Nenhuma locação.</div>'}function filterRental(b,s){document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('#rentalList [data-status]').forEach(x=>x.style.display=(s==='all'||x.dataset.status===s)?'flex':'none')}function rentalDetail(id){let r=db.rentals.find(x=>x.id===id),v=db.vehicles.find(x=>x.id===r.vehicleId),c=db.clients.find(x=>x.id===r.clientId);openModal('Detalhes da locação',`<div class="card"><b>${esc(v?.plate)} • ${esc(v?.brand)} ${esc(v?.model)}</b><div class="sub">Locatário: ${esc(c?.name)}<br>Status: ${esc(r.status)}</div></div><div class="section">Retirada</div><div class="note">${dbr(r.checkout.date)} • ${esc(r.checkout.km||'-')} km • ${esc(r.checkout.fuel||'-')}<br>${esc(r.checkout.obs||'Sem observações')}</div>${r.return?`<div class="section">Devolução</div><div class="note">${dbr(r.return.date)} • ${esc(r.return.km||'-')} km • ${esc(r.return.fuel||'-')}<br>${esc(r.return.obs||'Sem observações')}</div>`:''}`)}
function openWeekly(vid=''){if(!db.vehicles.length)return alert('Cadastre um veículo.');openModal('Nova vistoria semanal',`<div class="field"><label>Veículo *</label><select id="wVehicle">${vopts(false,vid)}</select></div><div class="two"><div class="field"><label>Data/hora</label><input id="wDate" type="datetime-local" value="${nowLocal()}"></div><div class="field"><label>KM</label><input id="wKm" type="number"></div></div><div class="field"><label>Combustível</label><select id="wFuel"><option>Reserva</option><option>1/4</option><option>1/2</option><option>3/4</option><option>Cheio</option></select></div><div class="section">Fotos obrigatórias</div>${photoInputs('wp',['Frente','Traseira','Lateral esquerda','Lateral direita','Painel / KM','Interior'])}<div class="section">Checklist</div>${checks.map((n,i)=>`<div class="check" data-check="${i}"><div class="name">${n}</div><div class="seg"><button data-v="OK" onclick="selCheck(this)">OK</button><button data-v="Atenção" onclick="selCheck(this)">Atenção</button><button data-v="Ruim" onclick="selCheck(this)">Ruim</button></div></div>`).join('')}<div class="field"><label>Observações</label><textarea id="wObs"></textarea></div><div class="section">Status final</div><div class="statusChoice"><button data-v="Aprovado" onclick="selStatus(this)">✅ Aprovado</button><button data-v="Precisa de atenção" onclick="selStatus(this)">⚠️ Precisa de atenção</button><button data-v="Não liberar" onclick="selStatus(this)">⛔ Não liberar</button></div><div class="section">Assinatura do responsável</div><canvas id="sig" class="signature"></canvas><button class="btn secondary" onclick="clearSig()">Limpar assinatura</button><div class="divider"></div><button class="btn full success" onclick="finishWeekly()">Finalizar vistoria</button>`);setTimeout(initSig,30)}function selCheck(b){b.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('sel'));b.classList.add('sel');b.closest('.check').dataset.value=b.dataset.v}function selStatus(b){b.parentElement.querySelectorAll('button').forEach(x=>x.classList.remove('sel'));b.classList.add('sel')}function initSig(){let c=sig;if(!c)return;let r=c.getBoundingClientRect();c.width=Math.round(r.width*devicePixelRatio);c.height=Math.round(r.height*devicePixelRatio);sigCtx=c.getContext('2d');sigCtx.scale(devicePixelRatio,devicePixelRatio);sigCtx.lineWidth=2;sigCtx.lineCap='round';let pt=e=>{let q=c.getBoundingClientRect(),t=e.touches?e.touches[0]:e;return [t.clientX-q.left,t.clientY-q.top]};let down=e=>{sigDown=true;let p=pt(e);sigCtx.beginPath();sigCtx.moveTo(...p);e.preventDefault()},move=e=>{if(!sigDown)return;let p=pt(e);sigCtx.lineTo(...p);sigCtx.stroke();e.preventDefault()},up=()=>sigDown=false;c.addEventListener('touchstart',down,{passive:false});c.addEventListener('touchmove',move,{passive:false});c.addEventListener('touchend',up);c.addEventListener('mousedown',down);c.addEventListener('mousemove',move);c.addEventListener('mouseup',up)}function clearSig(){sigCtx?.clearRect(0,0,sig.width,sig.height)}
async function finishWeekly(){let status=document.querySelector('.statusChoice button.sel')?.dataset.v;if(!status)return alert('Selecione o status final.');let vals=[...document.querySelectorAll('[data-check]')];if(vals.some(x=>!x.dataset.value))return alert('Preencha todos os itens do checklist.');let photos=await collectPhotos('wp',6);if(photos.length<4&&!confirm('Foram adicionadas menos de 4 fotos. Deseja salvar mesmo assim?'))return;let ck={};vals.forEach((x,i)=>ck[checks[i]]=x.dataset.value);let rec={id:uid(),vehicleId:wVehicle.value,date:wDate.value,km:wKm.value,fuel:wFuel.value,checks:ck,obs:wObs.value,status,photos,signature:sig.toDataURL('image/png')};db.inspections.push(re