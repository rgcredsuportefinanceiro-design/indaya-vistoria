c);let v=db.vehicles.find(x=>x.id===rec.vehicleId);if(rec.km)v.km=rec.km;if(status!=='Aprovado'){v.status=status==='Não liberar'?'Manutenção':v.status;db.maintenance.push({id:uid(),vehicleId:v.id,date:rec.date,title:'Vistoria semanal: '+status,reason:rec.obs||Object.entries(ck).filter(([,x])=>x!=='OK').map(([k,x])=>k+': '+x).join(', '),done:false})}save();closeModal();alert('Vistoria salva.')}function showWeeklyHub(){let list=[...db.inspections].sort((a,b)=>new Date(b.date)-new Date(a.date));openModal('Vistorias semanais',`<button class="btn full primary" onclick="openWeekly()">+ Nova vistoria</button><div class="section">Histórico</div>${list.length?list.map(i=>{let v=db.vehicles.find(x=>x.id===i.vehicleId);return `<div class="row" onclick="inspectionDetail('${i.id}')"><div class="grow"><b>${esc(v?.plate)} • ${esc(v?.brand)} ${esc(v?.model)}</b><small>${dbr(i.date)} • ${esc(i.km||'-')} km</small></div>${badge(i.status)}</div>`}).join(''):'<div class="empty">Nenhuma vistoria.</div>'}`)}function inspectionDetail(id){let i=db.inspections.find(x=>x.id===id),v=db.vehicles.find(x=>x.id===i.vehicleId),badc=Object.entries(i.checks).filter(([,x])=>x!=='OK');openModal('Laudo de vistoria',`<div id="report"><div class="card"><b>${esc(v?.plate)} • ${esc(v?.brand)} ${esc(v?.model)}</b><div class="sub">${dbr(i.date)} • ${esc(i.km||'-')} km • Combustível ${esc(i.fuel||'-')}</div><div style="margin-top:8px">${badge(i.status)}</div></div><div class="section">Checklist</div>${Object.entries(i.checks).map(([k,x])=>`<div class="row"><div class="grow"><b>${esc(k)}</b></div>${badge(x==='OK'?'Aprovado':x==='Atenção'?'Precisa de atenção':'Não liberar')}</div>`).join('')}<div class="section">Observações</div><div class="note">${esc(i.obs||'Sem observações')}</div><div class="section">Itens de atenção</div><div class="note">${badc.length?badc.map(([k,x])=>esc(k)+': '+esc(x)).join('<br>'):'Nenhum'}</div></div><div class="actions noPrint" style="margin-top:14px"><button class="btn secondary" onclick="shareInspection('${id}')">Compartilhar</button><button class="btn primary" onclick="printCurrent()">Salvar PDF</button></div>`)}function shareInspection(id){let i=db.inspections.find(x=>x.id===id),v=db.vehicles.find(x=>x.id===i.vehicleId);let t=`INDAYÁ LOCAÇÕES\nVistoria semanal\nVeículo: ${v?.plate} - ${v?.brand} ${v?.model}\nData: ${dbr(i.date)}\nKM: ${i.km}\nStatus: ${i.status}\nObservações: ${i.obs||'Sem observações'}`;if(window.Android?.shareText)Android.shareText(t);else navigator.share?.({text:t})}function printCurrent(){if(window.Android?.printPage)Android.printPage();else window.print()}
function showMaintenance(){let list=[...db.maintenance].sort((a,b)=>Number(a.done)-Number(b.done)||new Date(b.date)-new Date(a.date));openModal('Manutenção',`<div class="tabs"><button class="tab active" onclick="maintFilter(this,'open')">Pendentes</button><button class="tab" onclick="maintFilter(this,'all')">Todas</button></div><div id="maintList" class="list" style="margin-top:10px">${list.length?list.map(m=>{let v=db.vehicles.find(x=>x.id===m.vehicleId);return `<div class="row" data-done="${m.done?'1':'0'}"><div class="grow"><b>${esc(v?.plate)} • ${esc(m.title||'Manutenção')}</b><small>${dbr(m.date)}<br>${esc(m.reason||'')}</small></div>${m.done?'<span class="tag ok">Concluída</span>':`<button class="btn success" style="padding:8px" onclick="doneMaint('${m.id}')">Concluir</button>`}</div>`}).join(''):'<div class="empty">Nenhuma manutenção.</div>'}</div>`);setTimeout(()=>maintFilter(document.querySelector('#modal .tab'),'open'),20)}function maintFilter(b,s){document.querySelectorAll('#modal .tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('#maintList [data-done]').forEach(x=>x.style.display=(s==='all'||x.dataset.done==='0')?'flex':'none')}function doneMaint(id){let m=db.maintenance.find(x=>x.id===id);m.done=true;let v=db.vehicles.find(x=>x.id===m.vehicleId);if(v&&!db.maintenance.some(x=>x.vehicleId===v.id&&!x.done))v.status='Disponível';save();showMaintenance()}
function showHistory(){let items=[...db.inspections.map(x=>({...x,kind:'Vistoria semanal'})),...db.rentals.flatMap(r=>[{...r.checkout,vehicleId:r.vehicleId,kind:'Retirada'},...(r.return?[{...r.return,vehicleId:r.vehicleId,kind:'Devolução'}]:[])])].sort((a,b)=>new Date(b.date)-new Date(a.date));openModal('Histórico',items.length?items.map(x=>{let v=db.vehicles.find(z=>z.id===x.vehicleId);return `<div class="row"><div class="grow"><b>${esc(v?.plate)} • ${esc(x.kind)}</b><small>${dbr(x.date)} • ${esc(x.km||'-')} km</small></div>${x.status?badge(x.status):''}</div>`}).join(''):'<div class="empty">Sem registros.</div>')}
function showReports(){let totalKm=db.rentals.filter(r=>r.return&&r.checkout.km&&r.return.km).reduce((s,r)=>s+Math.max(0,Number(r.return.km)-Number(r.checkout.km)),0),ap=db.inspections.filter(x=>x.status==='Aprovado').length,at=db.inspections.filter(x=>x.status!=='Aprovado').length;openModal('Relatórios',`<div class="grid2"><div class="card metric"><small>Veículos</small><b>${db.vehicles.length}</b></div><div class="card metric"><small>Locações</small><b>${db.rentals.length}</b></div><div class="card metric"><small>Vistorias aprovadas</small><b>${ap}</b></div><div class="card metric"><small>Com atenção</small><b>${at}</b></div></div><div class="section">Indicadores</div><div class="row"><div class="grow"><b>KM rodados em locações encerradas</b></div><b>${totalKm.toLocaleString('pt-BR')} km</b></div><div class="row"><div class="grow"><b>Manutenções pendentes</b></div><b>${db.maintenance.filter(x=>!x.done).length}</b></div><button class="btn full primary" style="margin-top:12px" onclick="printCurrent()">Salvar relatório em PDF</button>`)}
function openSettings(){openModal('Configurações',`<div class="field"><label>Nome da empresa</label><input id="sCompany" value="${esc(db.settings.company||'Indayá Locações')}"></div><div class="field"><label>Novo PIN de acesso</label><input id="sPin" type="password" inputmode="numeric" value="${esc(db.settings.pin||'1234')}"></div><div class="note">Os dados ficam armazenados neste aparelho. Faça backup regularmente.</div><button class="btn full primary" style="margin-top:12px" onclick="saveSettings()">Salvar configurações</button><button class="btn full danger" style="margin-top:8px" onclick="logout()">Sair do app</button>`)}function saveSettings(){db.settings.company=sCompany.value||'Indayá Locações';db.settings.pin=sPin.value||'1234';save();closeModal()}function logout(){sessionStorage.removeItem('indaya_auth');closeModal();ensureLogin()}
async function exportBackup(){let txt=JSON.stringify({version:2,exportedAt:new Date().toISOString(),db},null,2);if(window.Android?.exportJson)Android.exportJson(txt,'indaya-backup-'+new Date().toISOString().slice(0,10)+'.json');else{let b=new Blob([txt],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='indaya-backup.json';a.click()}}function importBackup(inp){let f=inp.files?.[0];if(!f)return;let r=new FileReader();r.onload=e=>{try{let x=JSON.parse(e.target.result),n=x.db||x;if(!n.vehicles||!n.inspections)throw 0;db=n;if(!db.settings)db.settings={pin:'1234',company:'Indayá Locações'};if(!db.rentals)db.rentals=[];save();alert('Backup importado com sucesso.')}catch{alert('Backup inválido.')}};r.readAsText(f)}
if(!db.vehicles.length){db.vehicles=[{id:uid(),plate:'ABC1D23',brand:'Chevrolet',model:'Onix',year:'2024',color:'Prata',km:'28450',status:'Disponível',obs:''},{id:uid(),plate:'DEF4G56',brand:'Volkswagen',model:'Polo',year:'2023',color:'Branco',km:'31700',status:'Disponível',obs:''}];db.clients=[{id:uid(),name:'Cliente demonstração',cpf:'',phone:'',cnh:'',obs:''}];save()}else render();ensureLogin();
</script></body></html>
