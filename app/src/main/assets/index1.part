<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#071C3D"><title>Indayá Vistoria</title>
<style>
:root{--navy:#071c3d;--blue:#0e3a78;--red:#e73535;--bg:#f3f6fb;--card:#fff;--text:#172238;--muted:#6f7d92;--line:#e1e8f2;--green:#159766;--amber:#db8b18;--danger:#cb2c2c}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}body{margin:0;font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--text);padding-bottom:76px}button,input,select,textarea{font:inherit}.hidden{display:none!important}.top{position:sticky;top:0;z-index:30;background:linear-gradient(135deg,var(--navy),#0a2d60 60%,var(--blue));color:#fff;padding:14px 14px 16px;box-shadow:0 5px 18px #071c3d2b}.brand{display:flex;align-items:center;gap:11px}.brand img{width:45px;height:45px;border-radius:12px;object-fit:cover;background:#fff}.brand b{display:block;font-size:19px}.brand small{opacity:.8}.toprow{display:flex;align-items:center;justify-content:space-between}.iconbtn{border:0;background:#ffffff1f;color:white;border-radius:11px;padding:8px 10px;font-weight:800}.page{display:none;padding:14px}.page.active{display:block}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:13px;box-shadow:0 4px 18px #122a4a0b}.metric small{color:var(--muted)}.metric b{display:block;font-size:25px;margin-top:5px}.section{font-size:18px;font-weight:900;margin:18px 2px 9px}.sub{font-size:12px;color:var(--muted)}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.quick button{border:0;background:#fff;border-radius:15px;padding:13px 6px;box-shadow:0 4px 16px #1026440d;font-weight:800;color:var(--text)}.quick span{display:block;font-size:23px;margin-bottom:5px}.list{display:flex;flex-direction:column;gap:8px}.row{display:flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:11px}.row .grow{flex:1;min-width:0}.row b{display:block}.row small{display:block;color:var(--muted);margin-top:3px;line-height:1.35}.tag{font-size:11px;font-weight:900;padding:5px 8px;border-radius:999px;white-space:nowrap}.ok{background:#e6f7ef;color:#08764b}.att{background:#fff3d9;color:#936000}.bad{background:#ffe7e7;color:#ad2222}.info{background:#e8f1ff;color:#174f93}.search{width:100%;padding:12px 13px;border:1px solid var(--line);border-radius:13px;background:#fff;margin-bottom:10px;outline:none}.btn{border:0;border-radius:13px;padding:13px 14px;font-weight:900}.btn.full{width:100%}.primary{background:var(--red);color:#fff}.secondary{background:#eaf0f7;color:#17365f}.success{background:var(--green);color:white}.outline{background:white;color:var(--navy);border:1px solid #cfd9e7}.danger{background:#ffe9e9;color:#ad2222}.fab{position:fixed;right:17px;bottom:88px;width:56px;height:56px;border-radius:50%;border:0;background:var(--red);color:#fff;font-size:29px;box-shadow:0 9px 24px #e7353550;z-index:25}.bottom{position:fixed;bottom:0;left:0;right:0;height:70px;background:#fff;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(4,1fr);z-index:35}.bottom button{border:0;background:#fff;color:#7b8798;font-size:11px;font-weight:900}.bottom button.active{color:var(--red)}.bottom span{display:block;font-size:21px}.modal{position:fixed;inset:0;background:#071c3dd8;z-index:80;display:flex;align-items:flex-end}.sheet{width:100%;max-height:94vh;overflow:auto;background:var(--bg);border-radius:22px 22px 0 0;padding:14px 14px 26px}.sheetHead{position:sticky;top:-14px;z-index:4;background:var(--bg);display:flex;align-items:center;justify-content:space-between;padding:12px 0}.sheetHead b{font-size:19px}.close{width:36px;height:36px;border:0;border-radius:50%;background:#e6edf6;font-size:20px}.field{margin-bottom:11px}.field label{display:block;font-size:12px;font-weight:900;color:#526078;margin-bottom:5px}.field input,.field select,.field textarea{width:100%;padding:12px;border:1px solid #d7e0ec;border-radius:12px;background:#fff;outline:none}.field textarea{min-height:85px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:9px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.photos{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.photoBox{position:relative;min-height:112px;border:1.5px dashed #b4c4d9;border-radius:13px;background:#fff;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12px;color:#66748a}.photoBox input{position:absolute;inset:0;opacity:0}.photoBox img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.check{background:#fff;border:1px solid var(--line);border-radius:14px;padding:11px;margin-bottom:8px}.check .name{font-weight:900;margin-bottom:8px}.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.seg button{border:1px solid #d7e0ec;background:#f7f9fc;border-radius:10px;padding:9px 4px;font-size:12px;font-weight:900}.seg button.sel[data-v="OK"]{background:#e6f7ef;border-color:#8ed1b3;color:#08764b}.seg button.sel[data-v="Atenção"]{background:#fff3db;border-color:#eac56f;color:#936000}.seg button.sel[data-v="Ruim"]{background:#ffe8e8;border-color:#e79a9a;color:#ad2222}.statusChoice{display:flex;flex-direction:column;gap:7px}.statusChoice button{border:1px solid #d6e0ec;background:#fff;border-radius:12px;padding:12px;text-align:left;font-weight:900}.statusChoice button.sel[data-v="Aprovado"]{background:#e6f7ef;color:#08764b;border-color:#83cdaa}.statusChoice button.sel[data-v="Precisa de atenção"]{background:#fff3da;color:#936000;border-color:#e7c26c}.statusChoice button.sel[data-v="Não liberar"]{background:#ffe8e8;color:#ad2222;border-color:#e59797}.signature{width:100%;height:150px;background:#fff;border:1px solid #d6e0ec;border-radius:12px;touch-action:none}.tabs{display:flex;gap:7px;overflow:auto;padding-bottom:4px}.tab{white-space:nowrap;border:1px solid #d7e0ec;background:#fff;border-radius:999px;padding:8px 11px;font-size:12px;font-weight:900}.tab.active{background:var(--navy);color:#fff;border-color:var(--navy)}.empty{text-align:center;color:var(--muted);padding:26px 8px}.note{background:#eaf2fb;border-radius:12px;padding:10px;color:#53627a;font-size:12px;line-height:1.4}.divider{height:1px;background:var(--line);margin:13px 0}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.login{position:fixed;inset:0;z-index:120;background:linear-gradient(160deg,var(--navy),#0b3c80);display:flex;align-items:center;justify-content:center;padding:20px}.loginbox{width:100%;max-width:420px;background:#fff;border-radius:22px;padding:22px;box-shadow:0 20px 60px #0004}.loginbox img{display:block;width:82px;height:82px;object-fit:cover;border-radius:18px;margin:0 auto 12px}.loginbox h1{text-align:center;font-size:22px;margin:0}.loginbox p{text-align:center;color:var(--muted);font-size:13px}.loginbox input{width:100%;padding:14px;border:1px solid #d8e0ec;border-radius:13px;margin:10px 0}.due{border-left:5px solid var(--red)}.thumb{width:54px;height:45px;border-radius:9px;object-fit:cover;background:#e9eef5}.printOnly{display:none}@media print{.top,.bottom,.fab,.noPrint{display:none!important}.printOnly{display:block}.page{display:block!important;padding:0}.card,.row{box-shadow:none}body{padding:0;background:#fff}}
</style></head><body>
<div id="login" class="login hidden"><div class="loginbox"><img src="indaya_logo.jpg"><h1>Indayá Locações</h1><p>Vistoria e controle da frota</p><input id="pin" type="password" inputmode="numeric" placeholder="Digite o PIN"><button class="btn full primary" onclick="doLogin()">Entrar</button><p class="sub">PIN inicial: 1234 • altere em Configurações</p></div></div>
<header class="top"><div class="toprow"><div class="brand"><img src="indaya_logo.jpg"><div><b>INDAYÁ LOCAÇÕES</b><small>Vistoria de veículos</small></div></div><button class="iconbtn" onclick="openSettings()">⚙️</button></div></header>
<section id="painel" class="page active"><div class="grid2"><div class="card metric"><small>Vistorias da semana</small><b id="mWeek">0</b></div><div class="card metric"><small>Pendentes</small><b id="mPending">0</b></div><div class="card metric"><small>Manutenção</small><b id="mMaint">0</b></div><div class="card metric"><small>Veículos em uso</small><b id="mUse">0</b></div></div><div class="section">Acesso rápido</div><div class="quick"><button onclick="openWeekly()"><span>📋</span>Vistoria semanal</button><button onclick="openCheckout()"><span>🔑</span>Retirada</button><button onclick="openReturn()"><span>↩️</span>Devolução</button></div><div class="section">Vistorias que vencem esta semana</div><div id="dueList" class="list"></div><div class="section">Últimos registros</div><div id="latest" class="list"></div></section>
<section id="veiculos" class="page"><div class="section">Veículos</div><input class="search" id="vehicleSearch" placeholder="Buscar placa, marca ou modelo" oninput="renderVehicles()"><div id="vehicleList" class="list"></div><button class="fab" onclick="openVehicle()">+</button></section>
<section id="clientes" class="page"><div class="section">Locatários</div><input class="search" id="clientSearch" placeholder="Buscar nome, CPF ou telefone" oninput="renderClients()"><div id="clientList" class="list"></div><button class="fab" onclick="openClient()">+</button></section>
<section id="mais" class="page"><div class="section">Gestão</div><div class="list"><button class="btn outline" onclick="showWeeklyHub()">📅 Vistorias semanais</button><button class="btn outline" onclick="showRentals()">🚙 Locações ativas e encerradas</button><button class="btn outline" onclick="showMaintenance()">🔧 Manutenção</button><button class="btn outline" onclick="showHistory()">🕘 Histórico completo</button><button class="btn outline" onclick="showReports()">📊 Relatórios</button><button class="btn outline" onclick="exportBackup()">💾 Exportar backup</button><button class="btn outline" onclick="document.getElementById('importFile').click()">📥 Importar backup</button><input class="hidden" id="importFile" type="file" accept="application/json" onchange="importBackup(this)"></div></section>
<nav class="bottom"><button class="active" onclick="go('painel',this)"><span>⌂</span>Painel</button><button onclick="go('veiculos',this)"><span>🚗</span>Veículos</button><button onclick="go